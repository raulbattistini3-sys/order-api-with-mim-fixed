# Copy to .env.local. These stay on the server: never add a NEXT_PUBLIC_ prefix.
GATEWAY_URL=http://localhost:8081
# Must match the gateway's CLIENT_SECRET. This is the local development value.
CLIENT_SECRET=dev-secret-change-me-0123456789
# Must match limits.max_import_mb in the root config.toml.
MAX_IMPORT_MB=96
